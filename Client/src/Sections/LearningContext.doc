 this is Datadox ehrn we define the context
 import { createContext, useContext, useState } from "react";
import type { ReactNode } from "react";

type PeopleInfo = {
  username: string;
  email: string;
  password: string;
};

type BoxShape = {
  person: PeopleInfo | null;
  savePerson: (info: PeopleInfo) => void;
};

const DataBox = createContext<BoxShape | undefined>(undefined);

export function Keeper({ children }: { children: ReactNode }) {
  const [person, setPerson] = useState<PeopleInfo | null>(null);

  function savePerson(info: PeopleInfo) {
    setPerson(info);
  }

  return (
    <DataBox.Provider value={{ person, savePerson }}>
      {children}
    </DataBox.Provider>
  );
}

export function useGrab() {
  const found = useContext(DataBox);
  if (!found) throw new Error("useGrab must be used inside Keeper");
  return found;
}


