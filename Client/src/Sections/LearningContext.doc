signupd form
import { useState } from "react";
import type { ChangeEvent, FormEvent } from "react";
import { useGrab } from "./DataBox";

function SignupForm() {
  const { savePerson } = useGrab();
  const [typing, setTyping] = useState({
    username: "",
    email: "",
    password: "",
  });

  function onType(e: ChangeEvent<HTMLInputElement>) {
    setTyping({ ...typing, [e.target.name]: e.target.value });
  }

  function onSend(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    savePerson(typing); // puts the data into the context
  }

  return (
    <form onSubmit={onSend}>
      <input name="username" placeholder="Username" value={typing.username} onChange={onType} />
      <input name="email" type="email" placeholder="Email" value={typing.email} onChange={onType} />
      <input name="password" type="password" placeholder="Password" value={typing.password} onChange={onType} />
      <button type="submit">Save</button>
    </form>
  );
}

export default SignupForm;


