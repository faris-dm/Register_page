 this is Datadox ehrn we define the context
 import { createContext, useContext, useState } from "react";
import type { ReactNode } from "react";

type PeopleInfo = {
  username: string;
  email: string;
  password: string;
};

type BoxShape = {
  person: PeopleInfo | null;
  savePerson: (info: PeopleInfo) => void;
};

const DataBox = createContext<BoxShape | undefined>(undefined);

export function Keeper({ children }: { children: ReactNode }) {
  const [person, setPerson] = useState<PeopleInfo | null>(null);

  function savePerson(info: PeopleInfo) {
    setPerson(info);
  }

  return (
    <DataBox.Provider value={{ person, savePerson }}>
      {children}
    </DataBox.Provider>
  );
}

export function useGrab() {
  const found = useContext(DataBox);
  if (!found) throw new Error("useGrab must be used inside Keeper");
  return found;
}


 and this is the main.tsx
 import { createRoot } from "react-dom/client";
import App from "./App";
import { Keeper } from "./DataBox";

createRoot(document.getElementById("root")!).render(
  <Keeper>
    <App />
  </Keeper>
);


signupd form
import { useState } from "react";
import type { ChangeEvent, FormEvent } from "react";
import { useGrab } from "./DataBox";

function SignupForm() {
  const { savePerson } = useGrab();
  const [typing, setTyping] = useState({
    username: "",
    email: "",
    password: "",
  });

  function onType(e: ChangeEvent<HTMLInputElement>) {
    setTyping({ ...typing, [e.target.name]: e.target.value });
  }

  function onSend(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    savePerson(typing); // puts the data into the context
  }

  return (
    <form onSubmit={onSend}>
      <input name="username" placeholder="Username" value={typing.username} onChange={onType} />
      <input name="email" type="email" placeholder="Email" value={typing.email} onChange={onType} />
      <input name="password" type="password" placeholder="Password" value={typing.password} onChange={onType} />
      <button type="submit">Save</button>
    </form>
  );
}

export default SignupForm;


